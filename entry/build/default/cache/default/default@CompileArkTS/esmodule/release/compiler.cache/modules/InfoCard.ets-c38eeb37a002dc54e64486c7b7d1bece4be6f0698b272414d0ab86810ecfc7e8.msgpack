@Component
export struct TechCard {
  @Prop title: string = '';
  @Prop value: string = '';
  @Prop unit: string = '';
  @Prop trend: number = 0; // 0: æŒå¹³, 1: ä¸Šå‡, -1: ä¸‹é™
  @State glowIntensity: number = 0.5;

  aboutToAppear() {
    // å¯åŠ¨å‘¼å¸ç¯æ•ˆæœ
    setInterval(() => {
      this.glowIntensity = this.glowIntensity === 0.5 ? 0.8 : 0.5;
    }, 2000);
  }

  build() {
    Column() {
      // é¡¶éƒ¨è£…é¥°çº¿
      Row()
        .width('100%')
        .height(2)
        .backgroundColor($r('app.color.primary_color'))
        .opacity(this.glowIntensity)
        .animation({
          duration: 2000,
          curve: Curve.EaseInOut,
          iterations: -1,
          playMode: PlayMode.Alternate
        })

      Column() {
        Text(this.title)
          .fontSize(13)
          .fontColor($r('app.color.text_secondary'))
          .letterSpacing(1)
          .margin({ bottom: 8 })

        // æ•°å€¼å’Œå•ä½çš„ç»„åˆï¼Œè‡ªé€‚åº”å­—ä½“å¤§å°
        Row() {
          Text(this.value)
            .fontSize(this.value.length > 6 ? 20 : 24)
            .fontWeight(FontWeight.Bold)
            .fontColor($r('app.color.text_primary'))
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
            .flexShrink(1)

          if (this.unit) {
            Text(this.unit)
              .fontSize(12)
              .fontColor($r('app.color.text_secondary'))
              .margin({ left: 4 })
              .flexShrink(0)
          }
        }
        .width('100%')
        .alignItems(VerticalAlign.Bottom)

        // è¶‹åŠ¿æŒ‡ç¤ºå™¨ï¼ˆæ”¾åœ¨ä¸‹æ–¹ï¼‰
        if (this.trend !== 0) {
          Row() {
            Text(this.trend > 0 ? 'â–²' : 'â–¼')
              .fontSize(10)
              .fontColor(this.trend > 0 ? $r('app.color.success_color') : $r('app.color.error_color'))
              .margin({ right: 4 })
            
            Text(this.trend > 0 ? 'ä¸Šå‡' : 'ä¸‹é™')
              .fontSize(10)
              .fontColor(this.trend > 0 ? $r('app.color.success_color') : $r('app.color.error_color'))
          }
          .margin({ top: 4 })
        }
      }
      .width('100%')
      .padding(16)
      .alignItems(HorizontalAlign.Start)
    }
    .width('100%')
    .backgroundColor($r('app.color.background_card'))
    .borderRadius(16)
    .border({
      width: 1,
      color: $r('app.color.border_color')
    })
    .shadow({
      radius: 12,
      color: `rgba(0, 212, 255, ${0.1 * this.glowIntensity})`,
      offsetX: 0,
      offsetY: 0
    })
  }
}

// çŠ¶æ€æŒ‡ç¤ºå™¨å¡ç‰‡
@Component
export struct StatusCard {
  @Prop title: string = '';
  @Prop value: string = '';
  @Prop status: 'normal' | 'warning' | 'critical' = 'normal';
  @State pulseScale: number = 1;

  aboutToAppear() {
    if (this.status !== 'normal') {
      setInterval(() => {
        this.pulseScale = this.pulseScale === 1 ? 1.2 : 1;
      }, 1000);
    }
  }

  getStatusColor(): ResourceColor {
    switch (this.status) {
      case 'warning':
        return $r('app.color.warning_color');
      case 'critical':
        return $r('app.color.error_color');
      default:
        return $r('app.color.success_color');
    }
  }

  build() {
    Row() {
      // çŠ¶æ€æŒ‡ç¤ºç‚¹
      Column()
        .width(12)
        .height(12)
        .backgroundColor(this.getStatusColor())
        .borderRadius(6)
        .scale({ x: this.pulseScale, y: this.pulseScale })
        .animation({
          duration: 1000,
          curve: Curve.EaseInOut,
          iterations: -1,
          playMode: PlayMode.Alternate
        })
        .shadow({
          radius: 8,
          color: this.getStatusColor() as string,
          offsetX: 0,
          offsetY: 0
        })

      Column() {
        Text(this.title)
          .fontSize(13)
          .fontColor($r('app.color.text_secondary'))

        Text(this.value)
          .fontSize(18)
          .fontWeight(FontWeight.Medium)
          .fontColor($r('app.color.text_primary'))
          .margin({ top: 4 })
      }
      .alignItems(HorizontalAlign.Start)
      .margin({ left: 12 })
      .layoutWeight(1)
    }
    .width('100%')
    .padding(16)
    .backgroundColor($r('app.color.background_card'))
    .borderRadius(12)
    .border({
      width: 1,
      color: $r('app.color.border_color')
    })
  }
}
