  static async runAllTests(): Promise<void> {
    console.log('========== SystemInfoCore Test Start ==========');
    
    console.log('\n[Test 1] Device Info:');
    const deviceInfoResult = SystemInfoCore.getDeviceInfo();
    console.log('  è®¾å¤‡ç±»å‹:', deviceInfoResult.deviceType);
    console.log('  è®¾å¤‡å“ç‰Œ:', deviceInfoResult.brand);
    console.log('  è®¾å¤‡å‹å·:', deviceInfoResult.marketName);
    console.log('  ç³»ç»Ÿç‰ˆæœ¬:', deviceInfoResult.osFullName);
    console.log('  API ç‰ˆæœ¬:', deviceInfoResult.sdkApiVersion);
    console.log('  CPU æ¶æ„:', deviceInfoResult.abiList);

    console.log('\n[Test 2] Battery Info:');
    const batteryInfoResult = SystemInfoCore.getBatteryInfo();
    console.log('  ç”µæ± ç”µé‡:', batteryInfoResult.batterySOC + '%');
    console.log('  å……ç”µçŠ¶æ€:', batteryInfoResult.chargingStatus);
    console.log('  å¥åº·çŠ¶æ€:', batteryInfoResult.healthStatus);
    console.log('  ç”µæ± æ¸©åº¦:', (batteryInfoResult.batteryTemperature / 10).toFixed(1) + 'Â°C');

    console.log('\n[Test 3] Display Info:');
    const displayInfoResult = await SystemInfoCore.getDisplayInfo();
    if (displayInfoResult) {
      console.log('  å±å¹•å®½åº¦:', displayInfoResult.width + 'px');
      console.log('  å±å¹•é«˜åº¦:', displayInfoResult.height + 'px');
      console.log('  åƒç´ å¯†åº¦:', displayInfoResult.densityDPI + ' DPI');
      console.log('  åˆ·æ–°ç‡:', displayInfoResult.refreshRate + ' Hz');
    }

    console.log('\n[Test 4] Storage Info:');
    const storageInfoResult = SystemInfoCore.getStorageInfo();
    if (storageInfoResult) {
      console.log('  æ€»å­˜å‚¨:', (storageInfoResult.totalSize / 1024 / 1024 / 1024).toFixed(2) + ' GB');
      console.log('  å¯ç”¨å­˜å‚¨:', (storageInfoResult.freeSize / 1024 / 1024 / 1024).toFixed(2) + ' GB');
      console.log('  å·²ç”¨å­˜å‚¨:', (storageInfoResult.usedSize / 1024 / 1024 / 1024).toFixed(2) + ' GB');
    }

    console.log('\n[Test 5] Network Info:');
    const networkInfoResult = await SystemInfoCore.getNetworkInfo();
    if (networkInfoResult) {
      console.log('  ç½‘ç»œç±»å‹:', networkInfoResult.netType);
    }

    console.log('\n========== SystemInfoCore Test Complete ==========');
  }
