import { ConceptInfo, ConceptDetailItem, getConceptInfo } from '../config/ConceptConfig';
import { hilog } from '@kit.PerformanceAnalysisKit';

const TAG = 'ConceptDetailPage';

@Entry
@Component
struct ConceptDetailPage {
  @State conceptInfo: ConceptInfo | null = null;
  @State isLoading: boolean = true;

  aboutToAppear() {
    // è·å–è·¯ç”±å‚æ•°
    const params = router.getParams() as Record<string, string>;
    const conceptId = params?.['conceptId'];

    hilog.info(0x0000, TAG, 'Loading concept: %{public}s', conceptId);

    if (conceptId) {
      const info = getConceptInfo(conceptId);
      if (info) {
        this.conceptInfo = info;
      }
    }
    this.isLoading = false;
  }

  build() {
    Column() {
      // é¡¶éƒ¨å¯¼èˆªæ 
      Row() {
        Text('â† è¿”å›')
          .fontSize(16)
          .fontColor($r('app.color.primary_color'))
          .onClick(() => {
            router.back();
          });

        Text('æ¦‚å¿µè¯´æ˜')
          .fontSize(20)
          .fontWeight(FontWeight.Medium)
          .fontColor($r('app.color.text_primary'))
          .margin({ left: 12 });
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 12, bottom: 12 });

      Scroll() {
        Column() {
          if (this.isLoading) {
            Text('åŠ è½½ä¸­...')
              .fontSize(16)
              .fontColor($r('app.color.text_secondary'))
              .margin(24);
          } else if (!this.conceptInfo) {
            Column() {
              Text('æœªæ‰¾åˆ°æ¦‚å¿µä¿¡æ¯')
                .fontSize(18)
                .fontColor($r('app.color.text_secondary'))
                .margin(24);
            }
            .width('100%')
            .padding(24)
            .alignItems(HorizontalAlign.Center);
          } else {
            // æ¦‚å¿µæ ‡é¢˜
            Column() {
              Text(this.conceptInfo.title)
                .fontSize(28)
                .fontWeight(FontWeight.Bold)
                .fontColor($r('app.color.primary_color'))
                .width('100%');

              Text(this.conceptInfo.subtitle)
                .fontSize(14)
                .fontColor($r('app.color.text_secondary'))
                .margin({ top: 4 })
                .width('100%');

              // ç®€ä»‹
              Text(this.conceptInfo.description)
                .fontSize(14)
                .fontColor($r('app.color.text_secondary'))
                .margin({ top: 16 })
                .width('100%')
                .lineHeight(20);
            }
            .width('100%')
            .padding(16)
            .backgroundColor($r('app.color.background_card'))
            .borderRadius(12)
            .margin({ bottom: 16 });

            // è¯¦ç»†è¯´æ˜
            ForEach(this.conceptInfo.details, (detail: ConceptDetailItem, index: number) => {
              Column() {
                // æ ‡é¢˜å¸¦åºå·
                Row() {
                  Text(`${index + 1}`)
                    .fontSize(12)
                    .fontWeight(FontWeight.Bold)
                    .fontColor($r('app.color.background_dark'))
                    .width(20)
                    .height(20)
                    .backgroundColor($r('app.color.primary_color'))
                    .borderRadius(10)
                    .textAlign(TextAlign.Center);

                  Text(detail.title)
                    .fontSize(16)
                    .fontWeight(FontWeight.Medium)
                    .fontColor($r('app.color.text_primary'))
                    .margin({ left: 8 })
                    .layoutWeight(1);
                }
                .width('100%')
                .alignItems(VerticalAlign.Center);

                // å†…å®¹
                Text(detail.content)
                  .fontSize(14)
                  .fontColor($r('app.color.text_secondary'))
                  .margin({ top: 12 })
                  .width('100%')
                  .lineHeight(22);
              }
              .width('100%')
              .padding(16)
              .backgroundColor($r('app.color.background_card'))
              .borderRadius(12)
              .margin({ bottom: 12 });
            }, (detail: ConceptDetailItem, index: number) => index.toString());
          }
        }
        .width('100%')
        .padding(16);
      }
      .layoutWeight(1);
    }
    .width('100%')
    .height('100%')
    .backgroundColor($r('app.color.background_dark'));
