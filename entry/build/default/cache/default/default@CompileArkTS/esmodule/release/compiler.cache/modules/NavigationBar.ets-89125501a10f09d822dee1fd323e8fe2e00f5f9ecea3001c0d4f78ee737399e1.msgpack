export struct NavigationBar {
  @Prop title: string = '';
  onBack?: () => void;

  build() {
    Row() {
      // è¿”å›æŒ‰é’®åŒºåŸŸï¼ˆå›ºå®šå®½åº¦ï¼Œå·¦å¯¹é½ï¼‰
      Row() {
        Text('â†')
          .fontSize(28)
          .fontColor($r('app.color.primary_color'))
      }
      .width(48)
      .height(48)
      .justifyContent(FlexAlign.Center)
      .onClick(() => {
        if (this.onBack) {
          this.onBack();
        }
      })

      // æ ‡é¢˜åŒºåŸŸï¼ˆå±…ä¸­ï¼Œå æ®å‰©ä½™ç©ºé—´ï¼‰
      Text(this.title)
        .fontSize(18)
        .fontWeight(FontWeight.Medium)
        .fontColor($r('app.color.text_primary'))
        .textAlign(TextAlign.Center)
        .layoutWeight(1)
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })

      // å³ä¾§å ä½åŒºåŸŸï¼ˆä¸è¿”å›æŒ‰é’®åŒå®½ï¼Œä¿æŒæ ‡é¢˜å±…ä¸­ï¼‰
      Row()
        .width(48)
        .height(48)
    }
    .width('100%')
    .height(56)
    .padding({ left: 4, right: 4 })
    .backgroundColor($r('app.color.background_dark'))
  }
}

