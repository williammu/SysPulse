              .margin(24)
          } else {
            SectionHeader({ title: 'GPU åŸºæœ¬ä¿¡æ¯' });
            this.DataDescription('æ˜¾ç¤ºè®¾å¤‡çš„å›¾å½¢å¤„ç†å™¨(GPU)åŸºæœ¬ä¿¡æ¯ã€‚GPUè´Ÿè´£å›¾å½¢æ¸²æŸ“ã€å›¾åƒå¤„ç†ç­‰ä»»åŠ¡ã€‚');

            InfoCard({
              title: 'GPU å‚å•†',
              value: this.gpuVendor
            })

            InfoCard({
              title: 'GPU å‹å·',
              value: this.gpuRenderer
            })

            InfoCard({
              title: 'OpenGL ES ç‰ˆæœ¬',
              value: this.gpuVersion
            })

            SectionHeader({ title: 'GPU å†…å­˜' });
            this.DataDescription('å½“å‰ HarmonyOS ç‰ˆæœ¬æš‚ä¸æ”¯æŒç›´æ¥è·å– GPU å†…å­˜ä½¿ç”¨æƒ…å†µã€‚GPU å†…å­˜ä¸»è¦ç”¨äºçº¹ç†ã€ç¼“å†²åŒºã€å¸§ç¼“å†²ç­‰å›¾å½¢æ•°æ®å­˜å‚¨ã€‚');

            Column() {
              Text('GPU å†…å­˜ä¿¡æ¯æš‚ä¸å¯ç”¨')
                .fontSize(16)
                .fontColor($r('app.color.text_secondary'))
                .margin(16)

              Text('HiDebug API å½“å‰ç‰ˆæœ¬ä¸æ”¯æŒ GPU å†…å­˜æŸ¥è¯¢')
                .fontSize(14)
                .fontColor($r('app.color.text_secondary'))
            }
            .width('100%')
            .padding(16)
            .borderRadius(12)
            .backgroundColor($r('app.color.background_card'))
            .alignItems(HorizontalAlign.Center)

            SectionHeader({ title: 'è¯´æ˜' });
            this.DataDescription('GPU(å›¾å½¢å¤„ç†å™¨)æ˜¯ä¸“ä¸ºå›¾å½¢æ¸²æŸ“è®¾è®¡çš„å¤„ç†å™¨ã€‚åœ¨æ‰‹æœºä¸­ï¼ŒGPUè´Ÿè´£æ¸¸æˆç”»é¢æ¸²æŸ“ã€UIåŠ¨ç”»ã€è§†é¢‘è§£ç ç­‰ä»»åŠ¡ã€‚GPUå†…å­˜ç”¨äºå­˜å‚¨çº¹ç†ã€é¡¶ç‚¹æ•°æ®ã€å¸§ç¼“å†²ç­‰å›¾å½¢èµ„æºã€‚');
          }
