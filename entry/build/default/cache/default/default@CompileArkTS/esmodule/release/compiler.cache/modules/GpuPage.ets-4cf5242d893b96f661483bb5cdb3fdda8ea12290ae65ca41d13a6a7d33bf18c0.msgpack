      hilog.error(0x0000, TAG, 'Load GPU info error: %{public}s', String(error));
    }
  }

  // æ•°æ®è¯´æ˜ç»„ä»¶
  @Builder
  DataDescription(text: string) {
    Text(text)
      .fontSize(12)
      .fontColor($r('app.color.text_secondary'))
      .margin({ top: 4, bottom: 8 })
      .width('100%')
  }

  build() {
    Column() {
      Row() {
        Text('â† è¿”å›')
          .fontSize(16)
          .fontColor($r('app.color.primary_color'))
          .onClick(() => {
            router.back();
          })

        Text('GPU ä¿¡æ¯')
