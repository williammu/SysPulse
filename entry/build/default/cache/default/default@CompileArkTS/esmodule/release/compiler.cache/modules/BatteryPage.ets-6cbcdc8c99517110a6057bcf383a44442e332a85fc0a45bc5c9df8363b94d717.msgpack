            value: this.batteryInfo?.batteryTemperature ? `${(this.batteryInfo.batteryTemperature / 10).toFixed(1)}Â°C` : '--'
          })

          InfoCard({
            title: 'ç”µå‹',
            value: this.batteryInfo?.voltage ? `${this.batteryInfo.voltage} Î¼V` : '--'
          })

          InfoCard({
            title: 'ç”µæ± æŠ€æœ¯',
            value: this.batteryInfo?.technology || '--'
          })

          InfoCard({
            title: 'å¥åº·çŠ¶æ€',
            value: this.batteryInfo?.healthStatus !== undefined ? `${this.batteryInfo.healthStatus}` : '--'
          })

          InfoCard({
            title: 'å……ç”µå™¨ç±»å‹',
            value: this.batteryInfo?.pluggedType !== undefined ? `${this.batteryInfo.pluggedType}` : '--'
          })
        }
        .width('100%')
        .padding(16)
      }
      .layoutWeight(1)
    }
    .width('100%')
    .height('100%')
    .backgroundColor($r('app.color.background_dark'))
  }
}
