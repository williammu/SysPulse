  @Builder
  buildDeviceInfoSection() {
    Column({ space: 8 }) {
      Text('è®¾å¤‡ä¿¡æ¯')
        .fontSize(16)
        .fontWeight(FontWeight.Bold)
        .width('100%')

      this.buildInfoItem('è®¾å¤‡ç±»åž‹', this.deviceInfo?.deviceType || 'æœªçŸ¥')
      this.buildInfoItem('è®¾å¤‡åŽ‚å®¶', this.deviceInfo?.manufacture || 'æœªçŸ¥')
      this.buildInfoItem('è®¾å¤‡å“ç‰Œ', this.deviceInfo?.brand || 'æœªçŸ¥')
      this.buildInfoItem('å¸‚åœºåç§°', this.deviceInfo?.marketName || 'æœªçŸ¥')
      this.buildInfoItem('äº§å“ç³»åˆ—', this.deviceInfo?.productSeries || 'æœªçŸ¥')
      this.buildInfoItem('äº§å“åž‹å·', this.deviceInfo?.productModel || 'æœªçŸ¥')
      this.buildInfoItem('ç³»ç»Ÿç‰ˆæœ¬', this.deviceInfo?.osFullName || 'æœªçŸ¥')
      this.buildInfoItem('API ç‰ˆæœ¬', (this.deviceInfo?.sdkApiVersion || 0).toString())
      this.buildInfoItem('CPU æž¶æž„', this.deviceInfo?.abiList || 'æœªèŽ·å–')
    }
    .width('100%')
    .padding(12)
    .backgroundColor('#f0f8ff')
    .borderRadius(8)
  }

  @Builder
  buildBatteryInfoSection() {
    Column({ space: 8 }) {
      Text('ç”µæ± ä¿¡æ¯')
        .fontSize(16)
        .fontWeight(FontWeight.Bold)
        .width('100%')

      this.buildInfoItem('ç”µé‡', `${this.batteryInfo?.batterySOC || 0}%`)
      this.buildInfoItem('å……ç”µçŠ¶æ€', this.batteryInfo?.chargingStatus.toString() || '0')
      this.buildInfoItem('å¥åº·çŠ¶æ€', this.batteryInfo?.healthStatus.toString() || '0')
      this.buildInfoItem('æ¸©åº¦', `${((this.batteryInfo?.batteryTemperature || 0) / 10).toFixed(1)}Â°C`)
      this.buildInfoItem('ç”µåŽ‹', `${this.batteryInfo?.voltage || 0} Î¼V`)
      this.buildInfoItem('æŠ€æœ¯', this.batteryInfo?.technology || 'æœªçŸ¥')
    }
    .width('100%')
    .padding(12)
    .backgroundColor('#fff8f0')
    .borderRadius(8)
  }

  @Builder
  buildDisplayInfoSection() {
    Column({ space: 8 }) {
      Text('å±å¹•ä¿¡æ¯')
        .fontSize(16)
        .fontWeight(FontWeight.Bold)
        .width('100%')

      this.buildInfoItem('åˆ†è¾¨çŽ‡', `${this.displayInfo?.width || 0} Ã— ${this.displayInfo?.height || 0}`)
      this.buildInfoItem('åƒç´ å¯†åº¦', `${this.displayInfo?.densityDPI || 0} DPI`)
      this.buildInfoItem('åˆ·æ–°çŽ‡', `${this.displayInfo?.refreshRate || 0} Hz`)
      this.buildInfoItem('æ—‹è½¬è§’åº¦', `${this.displayInfo?.rotation || 0}Â°`)
      this.buildInfoItem('X DPI', `${this.displayInfo?.xDPI || 0}`)
      this.buildInfoItem('Y DPI', `${this.displayInfo?.yDPI || 0}`)
    }
    .width('100%')
    .padding(12)
    .backgroundColor('#f0fff0')
    .borderRadius(8)
  }

  @Builder
  buildStorageInfoSection() {
    Column({ space: 8 }) {
      Text('å­˜å‚¨ä¿¡æ¯')
        .fontSize(16)
        .fontWeight(FontWeight.Bold)
        .width('100%')

      this.buildInfoItem('æ€»å­˜å‚¨', this.getStorageDisplayValue(this.storageInfo?.totalSize))
      this.buildInfoItem('å¯ç”¨å­˜å‚¨', this.getStorageDisplayValue(this.storageInfo?.freeSize))
      this.buildInfoItem('å·²ç”¨å­˜å‚¨', this.getStorageDisplayValue(this.storageInfo?.usedSize))
    }
    .width('100%')
    .padding(12)
    .backgroundColor('#fff0f0')
