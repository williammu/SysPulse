  @Builder
  buildNetworkInfoSection() {
    Column({ space: 8 }) {
      Text('ç½‘ç»œä¿¡æ¯')
        .fontSize(16)
        .fontWeight(FontWeight.Bold)
        .width('100%')

      this.buildInfoItem('ç½‘ç»œç±»åž‹', this.networkInfo?.netType || 'æœªçŸ¥')
    }
    .width('100%')
    .padding(12)
    .backgroundColor('#f0f0ff')
    .borderRadius(8)
