  @Builder
  buildAppMemSection() {
    Column({ space: 8 }) {
      Text('åº”ç”¨å†…å­˜ (Native API)')
        .fontSize(16)
        .fontWeight(FontWeight.Bold)
        .width('100%')

      this.buildInfoItem('PSS', this.formatBytes(this.appMemInfo?.pss))
