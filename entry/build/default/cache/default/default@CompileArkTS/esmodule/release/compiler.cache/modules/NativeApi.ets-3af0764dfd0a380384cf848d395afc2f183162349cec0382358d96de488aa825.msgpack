        // å¦‚æœè¿˜æ²¡æœ‰åˆå§‹åŒ–ï¼Œå°è¯•æ£€æŸ¥å¯ç”¨æ€§
        if (!this.hasInitialized) {
            this.checkAvailability();
        }
        return this.isAvailable;
    }
    // ============ HiDebug API ============
    getSystemMemInfo() {
        if (!this.isAvailable)
            return null;
