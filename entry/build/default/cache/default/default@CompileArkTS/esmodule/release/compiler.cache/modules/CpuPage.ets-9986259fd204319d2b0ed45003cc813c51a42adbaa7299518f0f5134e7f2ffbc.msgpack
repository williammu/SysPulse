                                                    this.updateStateVarsOfChildByElmtId(elmtId, {
                                                        title: `çº¿ç¨‹ ${thread.threadId}`,
                                                        value: `${Math.round(thread.percentage)}%`
                                                    });
                                                }
                                            }, { name: "InfoCard" });
                                        }
                                    };
                                    this.forEachUpdateFunction(elmtId, this.cpuUsageAll.threads.slice(0, 15), forEachItemGenFunction, (thread) => thread.threadId.toString(), false, false);
                                }, ForEach);
                                ForEach.pop();
                            });
                        }
                        else {
                            this.ifElseBranchUpdateFunction(1, () => {
                            });
                        }
                    }, If);
                    If.pop();
