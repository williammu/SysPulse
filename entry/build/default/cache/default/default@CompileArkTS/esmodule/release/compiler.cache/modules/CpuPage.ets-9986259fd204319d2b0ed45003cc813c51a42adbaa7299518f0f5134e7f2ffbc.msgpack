import { DeviceUtil } from '../utils/DeviceUtil';
import { InfoCard } from '../components/InfoCard';
import { InfoHeader, InfoCardWithDesc } from '../components/InfoButton';
import { SimpleChart } from '../components/SimpleChart';
import { nativeApi, CpuUsage, CpuUsageAll, ThreadCpuInfo } from '../utils/NativeApi';
import { hilog } from '@kit.PerformanceAnalysisKit';

const TAG = 'CpuPage';
const REFRESH_INTERVAL = 200;
const CHART_MAX_POINTS = 50;

interface CpuBaseInfo {
  model: string;
  cores: number;
  architecture: string;
  process: string;
}

@Entry
@Component
struct CpuPage {
  @State cpuInfo: CpuBaseInfo | null = null;
  @State systemCpuUsage: CpuUsage | null = null;
  @State appCpuUsage: CpuUsage | null = null;
  @State cpuUsageAll: CpuUsageAll | null = null;
  @State isNativeAvailable: boolean = false;
  @State isLoading: boolean = true;
  @State systemCpuHistory: number[] = [];
  @State appCpuHistory: number[] = [];
  private refreshTimer: number | null = null;

  aboutToAppear() {
    const baseInfo = DeviceUtil.getCpuInfo();
    this.cpuInfo = {
      model: baseInfo.model || 'æœªèŽ·å–',
      cores: baseInfo.cores || 0,
      architecture: baseInfo.architecture || 'æœªèŽ·å–',
      process: baseInfo.process || 'æœªèŽ·å–'
    };

    this.isNativeAvailable = nativeApi.isNativeAvailable();

    if (this.isNativeAvailable) {
      this.loadCpuInfo();
      this.refreshTimer = setInterval(() => {
        this.loadCpuInfo();
      }, REFRESH_INTERVAL);
    }

    setTimeout(() => {
      this.isLoading = false;
    }, 100);
  }

  aboutToDisappear() {
    if (this.refreshTimer !== null) {
      clearInterval(this.refreshTimer);
      this.refreshTimer = null;
    }
  }

  loadCpuInfo() {
    this.systemCpuUsage = nativeApi.getSystemCpuUsage();
    this.appCpuUsage = nativeApi.getAppCpuUsage();
    this.cpuUsageAll = nativeApi.getCpuUsageAll();

    if (this.systemCpuUsage?.success) {
      this.systemCpuHistory.push(this.systemCpuUsage.percentage);
      if (this.systemCpuHistory.length > CHART_MAX_POINTS) {
        this.systemCpuHistory.shift();
      }
    }
    if (this.appCpuUsage?.success) {
      this.appCpuHistory.push(this.appCpuUsage.percentage);
      if (this.appCpuHistory.length > CHART_MAX_POINTS) {
        this.appCpuHistory.shift();
      }
    }
  }

  getSystemCpuUsagePercent(): number {
    if (this.systemCpuUsage?.success) {
      return Math.round(this.systemCpuUsage.percentage);
    }
    return 0;
  }

  getAppCpuUsagePercent(): number {
    if (this.appCpuUsage?.success) {
      return Math.round(this.appCpuUsage.percentage);
    }
    return 0;
  }

  getCoreCount(): string {
    if (this.cpuInfo && this.cpuInfo.cores > 0) {
      return `${this.cpuInfo.cores} æ ¸`;
    }
    return 'æœªèŽ·å–';
  }

  // è·³è½¬åˆ°æ¦‚å¿µè¯¦æƒ…é¡µ
  navigateToConcept(conceptId: string): void {
    router.pushUrl({
      url: 'pages/ConceptDetailPage',
      params: { conceptId: conceptId }
    });
  }

  build() {
    Column() {
      Row() {
        Text('â† è¿”å›ž')
          .fontSize(16)
          .fontColor($r('app.color.primary_color'))
          .onClick(() => {
            router.back();
          })

        Text('å¤„ç†å™¨')
          .fontSize(20)
          .fontWeight(FontWeight.Medium)
          .fontColor($r('app.color.text_primary'))
          .margin({ left: 12 })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 12, bottom: 12 })

      Scroll() {
        Column() {
          if (this.isLoading) {
            Text('åŠ è½½ä¸­...')
              .fontSize(16)
              .fontColor($r('app.color.text_secondary'))
              .margin(24)
          } else {
            // CPU ä½¿ç”¨çŽ‡æ¦‚è§ˆ
            InfoHeader({
              title: 'CPU ä½¿ç”¨çŽ‡',
              subtitle: 'æ˜¾ç¤ºç³»ç»Ÿå’Œåº”ç”¨çš„ CPU ä½¿ç”¨çŽ‡',
              conceptId: 'cpu_usage',
              onInfoClick: () => this.navigateToConcept('cpu_usage')
            });

            if (this.isNativeAvailable && this.systemCpuUsage?.success) {
              Column() {
                Text(`${this.getSystemCpuUsagePercent()}%`)
                  .fontSize(48)
                  .fontWeight(FontWeight.Bold)
                  .fontColor($r('app.color.primary_color'))

                Text('ç³»ç»Ÿ CPU ä½¿ç”¨çŽ‡')
                  .fontSize(14)
                  .fontColor($r('app.color.text_secondary'))
                  .margin({ top: 8 })
              }
              .width('100%')
              .padding(24)
              .borderRadius(12)
              .backgroundColor($r('app.color.background_card'))
              .alignItems(HorizontalAlign.Center)

              // CPU ä½¿ç”¨çŽ‡è¶‹åŠ¿å›¾
              if (this.systemCpuHistory.length > 1) {
                SimpleChart({
                  data: this.systemCpuHistory,
                  maxValue: 100,
                  color: '#007DFF',
                  title: 'ç³»ç»Ÿ CPU ä½¿ç”¨çŽ‡è¶‹åŠ¿'
                })
                .margin({ top: 16 })
              }

              // åº”ç”¨ CPU ä½¿ç”¨çŽ‡
              if (this.appCpuUsage?.success) {
                InfoCardWithDesc({
                  title: 'åº”ç”¨ CPU ä½¿ç”¨çŽ‡',
                  value: `${this.getAppCpuUsagePercent()}%`,
                  conceptId: 'cpu_usage',
                  onInfoClick: () => this.navigateToConcept('cpu_usage')
                })
              }
            } else {
              Column() {
                Text(this.isNativeAvailable ? 'æ— æ³•èŽ·å– CPU ä½¿ç”¨çŽ‡' : 'Native API ä¸å¯ç”¨')
                  .fontSize(18)
                  .fontColor($r('app.color.text_secondary'))
                  .margin(24)
              }
              .width('100%')
              .padding(24)
              .borderRadius(12)
              .backgroundColor($r('app.color.background_card'))
              .alignItems(HorizontalAlign.Center)
            }

            // CPU åŸºæœ¬ä¿¡æ¯
            InfoHeader({
              title: 'CPU ä¿¡æ¯',
              subtitle: 'æ˜¾ç¤º CPU çš„ç¡¬ä»¶è§„æ ¼ä¿¡æ¯'
            });

            InfoCard({
              title: 'æž¶æž„',
              value: this.cpuInfo?.architecture || 'æœªèŽ·å–'
            })

            InfoCard({
              title: 'æ ¸å¿ƒæ•°',
              value: this.getCoreCount()
            })

            InfoCard({
              title: 'åž‹å·',
              value: this.cpuInfo?.model || 'æœªèŽ·å–'
            })

            InfoCard({
              title: 'åˆ¶ç¨‹å·¥è‰º',
              value: this.cpuInfo?.process || 'æœªèŽ·å–'
            })

            // çº¿ç¨‹ CPU ä½¿ç”¨çŽ‡
            if (this.cpuUsageAll?.success && this.cpuUsageAll.threads.length > 0) {
              InfoHeader({
                title: `çº¿ç¨‹ CPU ä½¿ç”¨çŽ‡ (${this.cpuUsageAll.threadCount})`,
                subtitle: 'æ˜¾ç¤ºåº”ç”¨å„çº¿ç¨‹çš„ CPU ä½¿ç”¨çŽ‡',
                conceptId: 'thread_cpu',
                onInfoClick: () => this.navigateToConcept('thread_cpu')
              });

              ForEach(this.cpuUsageAll.threads.slice(0, 15), (thread: ThreadCpuInfo) => {
                InfoCard({
                  title: `çº¿ç¨‹ ${thread.threadId}`,
                  value: `${Math.round(thread.percentage)}%`
                })
              }, (thread: ThreadCpuInfo) => thread.threadId.toString())
            }
          }
        }
        .width('100%')
        .padding(16)
      }
      .layoutWeight(1)
    }
    .width('100%')
    .height('100%')
    .backgroundColor($r('app.color.background_dark'))
  }
}
