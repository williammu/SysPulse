import { DeviceUtil } from '../utils/DeviceUtil';
import { InfoCard } from '../components/InfoCard';
import { SectionHeader } from '../components/SectionHeader';
import { SimpleChart } from '../components/SimpleChart';
import { nativeApi, CpuUsage, CpuUsageAll, ThreadCpuInfo } from '../utils/NativeApi';
import { hilog } from '@kit.PerformanceAnalysisKit';

const TAG = 'CpuPage';
const REFRESH_INTERVAL = 200;
const CHART_MAX_POINTS = 50;

interface CpuBaseInfo {
  model: string;
  cores: number;
  architecture: string;
  process: string;
}

@Entry
@Component
struct CpuPage {
  @State cpuInfo: CpuBaseInfo | null = null;
  @State systemCpuUsage: CpuUsage | null = null;
  @State appCpuUsage: CpuUsage | null = null;
  @State cpuUsageAll: CpuUsageAll | null = null;
  @State isNativeAvailable: boolean = false;
  @State isLoading: boolean = true;
  @State systemCpuHistory: number[] = [];
  @State appCpuHistory: number[] = [];
  private refreshTimer: number | null = null;

  aboutToAppear() {
    const baseInfo = DeviceUtil.getCpuInfo();
    this.cpuInfo = {
      model: baseInfo.model || 'æœªè·å–',
      cores: baseInfo.cores || 0,
      architecture: baseInfo.architecture || 'æœªè·å–',
      process: baseInfo.process || 'æœªè·å–'
    };

    this.isNativeAvailable = nativeApi.isNativeAvailable();

    if (this.isNativeAvailable) {
      this.loadCpuInfo();
      this.refreshTimer = setInterval(() => {
        this.loadCpuInfo();
      }, REFRESH_INTERVAL);
    }

    setTimeout(() => {
      this.isLoading = false;
    }, 100);
  }

  aboutToDisappear() {
    if (this.refreshTimer !== null) {
      clearInterval(this.refreshTimer);
      this.refreshTimer = null;
    }
  }

  loadCpuInfo() {
    this.systemCpuUsage = nativeApi.getSystemCpuUsage();
    this.appCpuUsage = nativeApi.getAppCpuUsage();
    this.cpuUsageAll = nativeApi.getCpuUsageAll();

    if (this.systemCpuUsage?.success) {
      this.systemCpuHistory.push(this.systemCpuUsage.percentage);
      if (this.systemCpuHistory.length > CHART_MAX_POINTS) {
        this.systemCpuHistory.shift();
      }
    }
    if (this.appCpuUsage?.success) {
      this.appCpuHistory.push(this.appCpuUsage.percentage);
      if (this.appCpuHistory.length > CHART_MAX_POINTS) {
        this.appCpuHistory.shift();
      }
    }
  }

  getSystemCpuUsagePercent(): number {
    if (this.systemCpuUsage?.success) {
      return Math.round(this.systemCpuUsage.percentage);
    }
    return 0;
  }

  getAppCpuUsagePercent(): number {
    if (this.appCpuUsage?.success) {
      return Math.round(this.appCpuUsage.percentage);
    }
    return 0;
  }

  getCoreCount(): string {
    if (this.cpuInfo && this.cpuInfo.cores > 0) {
      return `${this.cpuInfo.cores} æ ¸`;
    }
    return 'æœªè·å–';
  }

  @Builder
  DataDescription(text: string) {
    Text(text)
      .fontSize(12)
      .fontColor($r('app.color.text_secondary'))
      .margin({ top: 4, bottom: 8 })
      .width('100%')
  }

  build() {
    Column() {
      Row() {
        Text('â† è¿”å›')
          .fontSize(16)
          .fontColor($r('app.color.primary_color'))
          .onClick(() => {
            router.back();
          })

        Text('å¤„ç†å™¨')
          .fontSize(20)
          .fontWeight(FontWeight.Medium)
          .margin({ left: 12 })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 12, bottom: 12 })

      Scroll() {
        Column() {
          if (this.isLoading) {
            Text('åŠ è½½ä¸­...')
              .fontSize(16)
              .fontColor($r('app.color.text_secondary'))
              .margin(24)
          } else {
            // CPU ä½¿ç”¨ç‡æ¦‚è§ˆ
            SectionHeader({ title: 'CPU ä½¿ç”¨ç‡' });
            this.DataDescription('æ˜¾ç¤ºç³»ç»Ÿå’Œåº”ç”¨çš„ CPU ä½¿ç”¨ç‡ã€‚CPU ä½¿ç”¨ç‡è¡¨ç¤ºå¤„ç†å™¨åœ¨ä¸€æ®µæ—¶é—´å†…å¤„äºå¿™ç¢ŒçŠ¶æ€çš„æ—¶é—´æ¯”ä¾‹ã€‚');

            if (this.isNativeAvailable && this.systemCpuUsage?.success) {
              Column() {
                Text(`${this.getSystemCpuUsagePercent()}%`)
                  .fontSize(48)
                  .fontWeight(FontWeight.Bold)
                  .fontColor($r('app.color.primary_color'))

                Text('ç³»ç»Ÿ CPU ä½¿ç”¨ç‡')
                  .fontSize(14)
                  .fontColor($r('app.color.text_secondary'))
                  .margin({ top: 8 })
              }
              .width('100%')
              .padding(24)
              .borderRadius(12)
              .backgroundColor($r('app.color.card_bg'))
              .alignItems(HorizontalAlign.Center)

              // CPU ä½¿ç”¨ç‡è¶‹åŠ¿å›¾
              if (this.systemCpuHistory.length > 1) {
                SimpleChart({
                  data: this.systemCpuHistory,
                  maxValue: 100,
                  color: '#007DFF',
                  title: 'ç³»ç»Ÿ CPU ä½¿ç”¨ç‡è¶‹åŠ¿'
                })
                .margin({ top: 16 })
              }

              // åº”ç”¨ CPU ä½¿ç”¨ç‡
              if (this.appCpuUsage?.success) {
                InfoCard({
                  title: 'åº”ç”¨ CPU ä½¿ç”¨ç‡',
                  value: `${this.getAppCpuUsagePercent()}%`
                })
              }
            } else {
              Column() {
                Text(this.isNativeAvailable ? 'æ— æ³•è·å– CPU ä½¿ç”¨ç‡' : 'Native API ä¸å¯ç”¨')
                  .fontSize(18)
                  .fontColor($r('app.color.text_secondary'))
                  .margin(24)
              }
              .width('100%')
              .padding(24)
              .borderRadius(12)
              .backgroundColor($r('app.color.card_bg'))
              .alignItems(HorizontalAlign.Center)
            }

            // CPU åŸºæœ¬ä¿¡æ¯
            SectionHeader({ title: 'CPU ä¿¡æ¯' });
            this.DataDescription('æ˜¾ç¤º CPU çš„ç¡¬ä»¶è§„æ ¼ä¿¡æ¯ï¼ŒåŒ…æ‹¬æ¶æ„ã€æ ¸å¿ƒæ•°ã€å‹å·ç­‰ã€‚');

            InfoCard({
              title: 'æ¶æ„',
              value: this.cpuInfo?.architecture || 'æœªè·å–'
            })

            InfoCard({
              title: 'æ ¸å¿ƒæ•°',
              value: this.getCoreCount()
            })

            InfoCard({
              title: 'å‹å·',
              value: this.cpuInfo?.model || 'æœªè·å–'
            })

            InfoCard({
              title: 'åˆ¶ç¨‹å·¥è‰º',
              value: this.cpuInfo?.process || 'æœªè·å–'
            })

            // çº¿ç¨‹ CPU ä½¿ç”¨ç‡
            if (this.cpuUsageAll?.success && this.cpuUsageAll.threads.length > 0) {
              SectionHeader({ title: `çº¿ç¨‹ CPU ä½¿ç”¨ç‡ (${this.cpuUsageAll.threadCount})` });
              this.DataDescription('æ˜¾ç¤ºåº”ç”¨å„çº¿ç¨‹çš„ CPU ä½¿ç”¨ç‡ã€‚çº¿ç¨‹æ˜¯ç¨‹åºæ‰§è¡Œçš„æœ€å°å•ä½ï¼Œå¤šçº¿ç¨‹å¯ä»¥æé«˜ç¨‹åºçš„å¹¶å‘æ€§èƒ½ã€‚');

              ForEach(this.cpuUsageAll.threads.slice(0, 15), (thread: ThreadCpuInfo) => {
                InfoCard({
                  title: `çº¿ç¨‹ ${thread.threadId}`,
                  value: `${Math.round(thread.percentage)}%`
                })
              }, (thread: ThreadCpuInfo) => thread.threadId.toString())
            }
          }
        }
        .width('100%')
        .padding(16)
      }
      .layoutWeight(1)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F7F8FA')
  }
}
