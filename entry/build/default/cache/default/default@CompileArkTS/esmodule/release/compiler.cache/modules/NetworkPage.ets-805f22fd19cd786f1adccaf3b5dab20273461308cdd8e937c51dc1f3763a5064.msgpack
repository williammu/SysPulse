  @State networkDetails: NetworkDetails | null = null;
  @State isLoading: boolean = true;

  async aboutToAppear() {
    hilog.info(0x0000, TAG, 'NetworkPage aboutToAppear');
    await this.loadNetworkInfo();
    setTimeout(() => {
      this.isLoading = false;
    }, 100);
  }

  async loadNetworkInfo() {
    try {
      const netHandle = connection.getDefaultNetSync();
      hilog.info(0x0000, TAG, 'NetHandle: netId=%{public}d', netHandle?.netId || 0);

      if (netHandle && netHandle.netId !== 0) {
        const netCapabilities = connection.getNetCapabilitiesSync(netHandle);
        const connectionProperties = connection.getConnectionPropertiesSync(netHandle);

        hilog.info(0x0000, TAG, 'NetCapabilities: %{public}s', JSON.stringify(netCapabilities));
        hilog.info(0x0000, TAG, 'ConnectionProperties: %{public}s', JSON.stringify(connectionProperties));

        const bearerType = netCapabilities.bearerTypes?.[0] || connection.NetBearType.BEARER_CELLULAR;
        const networkCap = netCapabilities.networkCap || [];
        const linkUpBandwidth = netCapabilities.linkUpBandwidthKbps || 0;
        const linkDownBandwidth = netCapabilities.linkDownBandwidthKbps || 0;

        hilog.info(0x0000, TAG, 'Bandwidth: up=%{public}d, down=%{public}d', linkUpBandwidth, linkDownBandwidth);

        // è§£æè¿æ¥å±æ€§
        const connProps = JSON.parse(JSON.stringify(connectionProperties)) as Record<string, string | number | object | object[]>;

        // å®‰å…¨åœ°è·å–å±æ€§å€¼
        const getStringProp = (key: string): string => {
          const val = connProps[key];
          return typeof val === 'string' ? val : 'æœªçŸ¥';
        };

        const getNumberProp = (key: string): number => {
          const val = connProps[key];
          return typeof val === 'number' ? val : 0;
        };

        const getObjectArrayProp = (key: string): object[] => {
          const val = connProps[key];
          return Array.isArray(val) ? val : [];
        };

        // è§£æ IP åœ°å€
        const linkAddresses = getObjectArrayProp('linkAddresses');
        let ipAddress = 'æœªè·å–';
        let subnetMask = 'æœªè·å–';
        if (linkAddresses.length > 0) {
          const firstAddr = linkAddresses[0] as Record<string, string | number>;
          ipAddress = typeof firstAddr.address === 'string' ? firstAddr.address : 'æœªè·å–';
          subnetMask = typeof firstAddr.prefixLength === 'number' ? `/${firstAddr.prefixLength}` : 'æœªè·å–';
        }

        // è§£æç½‘å…³
        const gateway = connProps.gateway as Record<string, string> | undefined;
        const gatewayAddress = gateway?.address || 'æœªçŸ¥';

        // è§£æ DNS
        const dnsServers = getObjectArrayProp('dnsServers');
        const dnsList: string[] = [];
        for (const dns of dnsServers) {
          const dnsRecord = dns as Record<string, string>;
          if (typeof dnsRecord.address === 'string') {
            dnsList.push(dnsRecord.address);
          }
        }

        this.networkDetails = {
          type: this.getNetworkTypeName(bearerType),
          isConnected: true,
          isMetered: networkCap.includes(connection.NetCap.NET_CAPABILITY_NOT_METERED) ? false : true,
          isRoaming: false,
          linkUpBandwidth: linkUpBandwidth,
          linkDownBandwidth: linkDownBandwidth,
          // è¿æ¥å±æ€§
          interfaceName: getStringProp('interfaceName'),
          ipAddress: ipAddress,
          gateway: gatewayAddress,
          dnsServers: dnsList,
          mtu: getNumberProp('mtu'),
          macAddress: getStringProp('macAddress'),
          subnetMask: subnetMask,
          // WiFi ä¿¡æ¯
          ssid: getStringProp('ssid'),
          signalStrength: getNumberProp('signalStrength'),
          frequency: getNumberProp('frequency'),
          linkSpeed: getNumberProp('linkSpeed')
        };
      } else {
        this.networkDetails = {
          type: 'æ— ç½‘ç»œ',
          isConnected: false,
          isMetered: false,
          isRoaming: false,
          linkUpBandwidth: 0,
          linkDownBandwidth: 0,
          interfaceName: 'æ— ',
          ipAddress: 'æ— ',
          gateway: 'æ— ',
          dnsServers: [],
          mtu: 0,
          macAddress: 'æ— ',
          subnetMask: 'æ— ',
          ssid: '',
          signalStrength: 0,
          frequency: 0,
          linkSpeed: 0
        };
      }
    } catch (error) {
      hilog.error(0x0000, TAG, 'Load network info error: %{public}s', String(error));
      this.networkDetails = {
        type: 'æœªçŸ¥',
        isConnected: false,
        isMetered: false,
        isRoaming: false,
        linkUpBandwidth: 0,
        linkDownBandwidth: 0,
        interfaceName: 'æœªçŸ¥',
        ipAddress: 'æœªçŸ¥',
        gateway: 'æœªçŸ¥',
        dnsServers: [],
        mtu: 0,
        macAddress: 'æœªçŸ¥',
        subnetMask: 'æœªçŸ¥',
        ssid: '',
        signalStrength: 0,
        frequency: 0,
        linkSpeed: 0
      };
    }
  }

  getNetworkTypeName(bearerType: connection.NetBearType): string {
    switch (bearerType) {
      case connection.NetBearType.BEARER_CELLULAR:
        return 'ç§»åŠ¨æ•°æ®';
      case connection.NetBearType.BEARER_WIFI:
        return 'Wi-Fi';
      case connection.NetBearType.BEARER_BLUETOOTH:
        return 'è“ç‰™';
      case connection.NetBearType.BEARER_ETHERNET:
        return 'ä»¥å¤ªç½‘';
      case connection.NetBearType.BEARER_VPN:
        return 'VPN';
      default:
        return 'æœªçŸ¥';
    }
  }

  formatBandwidth(kbps: number): string {
    if (kbps <= 0) return 'æœªæä¾›';
    if (kbps >= 1000000) {
      return `${(kbps / 1000000).toFixed(1)} Gbps`;
    } else if (kbps >= 1000) {
      return `${(kbps / 1000).toFixed(1)} Mbps`;
    } else {
      return `${kbps} Kbps`;
    }
  }

  formatMtu(mtu: number): string {
    if (mtu <= 0) return 'æœªè·å–';
    return `${mtu} bytes`;
  }

  formatFrequency(freq: number): string {
    if (freq <= 0) return 'æœªè·å–';
    if (freq >= 1000) {
      return `${(freq / 1000).toFixed(1)} GHz`;
    }
    return `${freq} MHz`;
  }

  formatLinkSpeed(speed: number): string {
    if (speed <= 0) return 'æœªè·å–';
    return `${speed} Mbps`;
  }

  // æ•°æ®è¯´æ˜ç»„ä»¶
  @Builder
  DataDescription(text: string) {
    Text(text)
      .fontSize(12)
      .fontColor($r('app.color.text_secondary'))
      .margin({ top: 4, bottom: 8 })
      .width('100%')
  }

  build() {
    Column() {
      NavigationBarWithArrow({
        title: 'ç½‘ç»œ',
        onBack: () => {
          router.back();
        }
      })

      Scroll() {
        Column() {
          if (this.isLoading) {
            Text('åŠ è½½ä¸­...')
              .fontSize(16)
              .fontColor($r('app.color.text_secondary'))
              .margin(24)
          } else if (this.networkDetails) {
            // ç½‘ç»œçŠ¶æ€
            SectionHeader({ title: 'ç½‘ç»œçŠ¶æ€' });
            this.DataDescription('æ˜¾ç¤ºå½“å‰è®¾å¤‡çš„ç½‘ç»œè¿æ¥çŠ¶æ€å’Œç½‘ç»œç±»å‹ã€‚');

            InfoCard({
              title: 'ç½‘ç»œç±»å‹',
              value: this.networkDetails.type
            })

            InfoCard({
              title: 'è¿æ¥çŠ¶æ€',
              value: this.networkDetails.isConnected ? 'å·²è¿æ¥' : 'æœªè¿æ¥'
            })

            InfoCard({
              title: 'è®¡è´¹ç½‘ç»œ',
              value: this.networkDetails.isMetered ? 'æ˜¯' : 'å¦'
            })

            // IP é…ç½®
            SectionHeader({ title: 'IP é…ç½®' });
            this.DataDescription('æ˜¾ç¤ºå½“å‰ç½‘ç»œçš„ IP åœ°å€ã€å­ç½‘æ©ç ã€ç½‘å…³ç­‰é…ç½®ä¿¡æ¯ã€‚');

            InfoCard({
              title: 'IP åœ°å€',
              value: this.networkDetails.ipAddress
            })

            InfoCard({
              title: 'å­ç½‘å‰ç¼€',
              value: this.networkDetails.subnetMask
            })

            InfoCard({
              title: 'é»˜è®¤ç½‘å…³',
