            })

            // DNS æœåŠ¡å™¨
            SectionHeader({ title: 'DNS æœåŠ¡å™¨' });
            this.DataDescription('æ˜¾ç¤ºå½“å‰ç½‘ç»œé…ç½®çš„ DNS æœåŠ¡å™¨åœ°å€ï¼Œç”¨äºåŸŸåè§£æã€‚');

            if (this.networkDetails.dnsServers.length > 0) {
              ForEach(this.networkDetails.dnsServers, (dns: string, index: number) => {
                InfoCard({
                  title: `DNS ${index + 1}`,
                  value: dns
                })
              }, (dns: string, index: number) => index.toString())
            } else {
              InfoCard({
                title: 'DNS æœåŠ¡å™¨',
                value: 'æœªè·å–'
              })
            }

            // ç½‘å¡ä¿¡æ¯
            SectionHeader({ title: 'ç½‘å¡ä¿¡æ¯' });
            this.DataDescription('æ˜¾ç¤ºç½‘å¡åç§°ã€MAC åœ°å€ã€MTU ç­‰ç¡¬ä»¶ä¿¡æ¯ã€‚');

            InfoCard({
              title: 'ç½‘å¡åç§°',
              value: this.networkDetails.interfaceName
            })

            InfoCard({
              title: 'MAC åœ°å€',
              value: this.networkDetails.macAddress
            })

            InfoCard({
              title: 'MTU',
              value: this.formatMtu(this.networkDetails.mtu)
            })

            // WiFi è¯¦ç»†ä¿¡æ¯ï¼ˆä»… WiFi ç½‘ç»œæ˜¾ç¤ºï¼‰
            if (this.networkDetails.type === 'Wi-Fi' && this.networkDetails.ssid) {
              SectionHeader({ title: 'Wi-Fi ä¿¡æ¯' });
              this.DataDescription('æ˜¾ç¤º Wi-Fi ç½‘ç»œçš„è¯¦ç»†ä¿¡æ¯ã€‚');

              InfoCard({
                title: 'SSID',
                value: this.networkDetails.ssid
              })

              if (this.networkDetails.signalStrength > 0) {
                InfoCard({
                  title: 'ä¿¡å·å¼ºåº¦',
                  value: `${this.networkDetails.signalStrength} dBm`
                })
              }

              if (this.networkDetails.frequency > 0) {
                InfoCard({
                  title: 'é¢‘æ®µ',
                  value: this.formatFrequency(this.networkDetails.frequency)
                })
              }

              if (this.networkDetails.linkSpeed > 0) {
                InfoCard({
                  title: 'è¿æ¥é€Ÿåº¦',
                  value: this.formatLinkSpeed(this.networkDetails.linkSpeed)
                })
              }
            }

            // å¸¦å®½ä¿¡æ¯
            SectionHeader({ title: 'å¸¦å®½ä¿¡æ¯' });
            this.DataDescription('æ˜¾ç¤ºå½“å‰ç½‘ç»œè¿æ¥çš„ç†è®ºä¸Šè¡Œå’Œä¸‹è¡Œå¸¦å®½ã€‚æŸäº›ç½‘ç»œç±»å‹ï¼ˆå¦‚æ¨¡æ‹Ÿå™¨ç¯å¢ƒï¼‰å¯èƒ½ä¸æä¾›å¸¦å®½ä¿¡æ¯ã€‚å®é™…ç½‘é€Ÿå¯èƒ½å› ç½‘ç»œç¯å¢ƒã€ä¿¡å·å¼ºåº¦ç­‰å› ç´ è€Œæœ‰æ‰€ä¸åŒã€‚');

            InfoCard({
              title: 'ä¸Šè¡Œå¸¦å®½',
              value: this.formatBandwidth(this.networkDetails.linkUpBandwidth)
            })

            InfoCard({
              title: 'ä¸‹è¡Œå¸¦å®½',
              value: this.formatBandwidth(this.networkDetails.linkDownBandwidth)
            })

            // è¯´æ˜
            SectionHeader({ title: 'è¯´æ˜' });
            this.DataDescription('ç½‘ç»œä¿¡æ¯é€šè¿‡ @ohos.net.connection API è·å–ã€‚IP é…ç½®ã€DNSã€ç½‘å…³ç­‰ä¿¡æ¯ç”¨äºç½‘ç»œè¯Šæ–­å’Œæ•…éšœæ’æŸ¥ã€‚MAC åœ°å€æ˜¯ç½‘å¡çš„ç‰©ç†åœ°å€ï¼ŒMTU æ˜¯æœ€å¤§ä¼ è¾“å•å…ƒã€‚');
          } else {
            Column() {
              Text('æ— æ³•è·å–ç½‘ç»œä¿¡æ¯')
                .fontSize(18)
                .fontColor($r('app.color.text_secondary'))
                .margin(24)
            }
            .width('100%')
            .padding(24)
            .borderRadius(12)
            .backgroundColor($r('app.color.background_card'))
