import connection from '@ohos.net.connection';
import { InfoCard } from '../components/InfoCard';
import { SectionHeader } from '../components/SectionHeader';
import { hilog } from '@kit.PerformanceAnalysisKit';

const TAG = 'NetworkPage';

interface NetworkDetails {
  type: string;
  isConnected: boolean;
  isMetered: boolean;
  isRoaming: boolean;
  linkUpBandwidth: number;
  linkDownBandwidth: number;
}

@Entry
@Component
struct NetworkPage {
  @State networkDetails: NetworkDetails | null = null;
  @State isLoading: boolean = true;

  async aboutToAppear() {
    hilog.info(0x0000, TAG, 'NetworkPage aboutToAppear');
    await this.loadNetworkInfo();
    setTimeout(() => {
      this.isLoading = false;
    }, 100);
  }

  async loadNetworkInfo() {
    try {
      const netHandle = connection.getDefaultNetSync();
      if (netHandle && netHandle.netId !== 0) {
        const netCapabilities = connection.getNetCapabilitiesSync(netHandle);
        const connectionProperties = connection.getConnectionPropertiesSync(netHandle);

        const bearerType = netCapabilities.bearerTypes[0] || connection.NetBearType.BEARER_CELLULAR;
        const networkCap = netCapabilities.networkCap || [];
        const linkUpBandwidth = netCapabilities.linkUpBandwidthKbps || 0;
        const linkDownBandwidth = netCapabilities.linkDownBandwidthKbps || 0;

        this.networkDetails = {
          type: this.getNetworkTypeName(bearerType),
          isConnected: true,
          isMetered: networkCap.includes(connection.NetCap.NET_CAPABILITY_NOT_METERED) ? false : true,
          isRoaming: false, // éœ€è¦é¢å¤–æƒé™
          linkUpBandwidth: linkUpBandwidth,
          linkDownBandwidth: linkDownBandwidth
        };
      } else {
        this.networkDetails = {
          type: 'æ— ç½‘ç»œ',
          isConnected: false,
          isMetered: false,
          isRoaming: false,
          linkUpBandwidth: 0,
          linkDownBandwidth: 0
        };
      }
    } catch (error) {
      hilog.error(0x0000, TAG, 'Load network info error: %{public}s', String(error));
      this.networkDetails = {
        type: 'æœªçŸ¥',
        isConnected: false,
        isMetered: false,
        isRoaming: false,
        linkUpBandwidth: 0,
        linkDownBandwidth: 0
      };
    }
  }

  getNetworkTypeName(bearerType: connection.NetBearType): string {
    switch (bearerType) {
      case connection.NetBearType.BEARER_CELLULAR:
        return 'ç§»åŠ¨æ•°æ®';
      case connection.NetBearType.BEARER_WIFI:
        return 'Wi-Fi';
      case connection.NetBearType.BEARER_BLUETOOTH:
        return 'è“ç‰™';
      case connection.NetBearType.BEARER_ETHERNET:
        return 'ä»¥å¤ªç½‘';
      case connection.NetBearType.BEARER_VPN:
        return 'VPN';
      default:
        return 'æœªçŸ¥';
    }
  }

  formatBandwidth(kbps: number): string {
    if (kbps <= 0) return 'æœªçŸ¥';
    if (kbps >= 1000000) {
      return `${(kbps / 1000000).toFixed(1)} Gbps`;
    } else if (kbps >= 1000) {
      return `${(kbps / 1000).toFixed(1)} Mbps`;
    } else {
      return `${kbps} Kbps`;
    }
  }

  // æ•°æ®è¯´æ˜ç»„ä»¶
  @Builder
  DataDescription(text: string) {
    Text(text)
      .fontSize(12)
      .fontColor($r('app.color.text_secondary'))
      .margin({ top: 4, bottom: 8 })
      .width('100%')
  }

  build() {
    Column() {
      Row() {
        Text('â† è¿”å›')
          .fontSize(16)
          .fontColor($r('app.color.primary_color'))
          .onClick(() => {
            router.back();
          })

        Text('ç½‘ç»œ')
          .fontSize(20)
          .fontWeight(FontWeight.Medium)
          .margin({ left: 12 })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 12, bottom: 12 })

      Scroll() {
        Column() {
          if (this.isLoading) {
            Text('åŠ è½½ä¸­...')
              .fontSize(16)
              .fontColor($r('app.color.text_secondary'))
              .margin(24)
          } else if (this.networkDetails) {
            SectionHeader({ title: 'ç½‘ç»œçŠ¶æ€' });
            this.DataDescription('æ˜¾ç¤ºå½“å‰è®¾å¤‡çš„ç½‘ç»œè¿æ¥çŠ¶æ€å’Œç½‘ç»œç±»å‹ã€‚');

            InfoCard({
              title: 'ç½‘ç»œç±»å‹',
              value: this.networkDetails.type
            })

            InfoCard({
              title: 'è¿æ¥çŠ¶æ€',
              value: this.networkDetails.isConnected ? 'å·²è¿æ¥' : 'æœªè¿æ¥'
            })

            InfoCard({
              title: 'è®¡è´¹ç½‘ç»œ',
              value: this.networkDetails.isMetered ? 'æ˜¯' : 'å¦'
            })

            SectionHeader({ title: 'å¸¦å®½ä¿¡æ¯' });
            this.DataDescription('æ˜¾ç¤ºå½“å‰ç½‘ç»œè¿æ¥çš„ç†è®ºä¸Šè¡Œå’Œä¸‹è¡Œå¸¦å®½ã€‚å®é™…ç½‘é€Ÿå¯èƒ½å› ç½‘ç»œç¯å¢ƒã€ä¿¡å·å¼ºåº¦ç­‰å› ç´ è€Œæœ‰æ‰€ä¸åŒã€‚');

            InfoCard({
              title: 'ä¸Šè¡Œå¸¦å®½',
              value: this.formatBandwidth(this.networkDetails.linkUpBandwidth)
            })

            InfoCard({
              title: 'ä¸‹è¡Œå¸¦å®½',
              value: this.formatBandwidth(this.networkDetails.linkDownBandwidth)
            })

            SectionHeader({ title: 'è¯´æ˜' });
            this.DataDescription('ç½‘ç»œä¿¡æ¯é€šè¿‡ @ohos.net.connection API è·å–ã€‚ç§»åŠ¨æ•°æ®ç½‘ç»œé€šå¸¸æŒ‰æµé‡è®¡è´¹ï¼ŒWi-Fi ç½‘ç»œé€šå¸¸ä¸è®¡è´¹ã€‚å¸¦å®½ä¿¡æ¯ç”±ç³»ç»Ÿæ ¹æ®ç½‘ç»œç±»å‹ä¼°ç®—ï¼Œä¸ä»£è¡¨å®é™…æµ‹é€Ÿç»“æœã€‚');
          } else {
            Column() {
              Text('æ— æ³•è·å–ç½‘ç»œä¿¡æ¯')
                .fontSize(18)
                .fontColor($r('app.color.text_secondary'))
                .margin(24)
            }
            .width('100%')
            .padding(24)
            .borderRadius(12)
            .backgroundColor($r('app.color.card_bg'))
            .alignItems(HorizontalAlign.Center)
          }
        }
        .width('100%')
        .padding(16)
      }
      .layoutWeight(1)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F7F8FA')
  }
}
